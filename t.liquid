{% comment %} Précharge image principale pour LCP {% endcomment %}
{%- assign lcp_img = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
{% if lcp_img %}
  <link rel="preload" as="image"
    href="{{ lcp_img | image_url: width: 600 }}"
    imagesrcset="{{ lcp_img | image_url: width: 400 }} 400w, {{ lcp_img | image_url: width: 600 }} 600w"
    imagesizes="(max-width: 600px) 100vw, 600px">
{% endif %}

{% comment %} BOOMBA product section — PREMIUM BUNDLE SELECTOR {% endcomment %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-boomba-image-card-{{ai_gen_id}},
  .ai-boomba-thumbnails-wrapper-{{ai_gen_id}},
  .ai-boomba-reviews-{{ai_gen_id}},
  .ai-boomba-title-{{ai_gen_id}},
  .ai-boomba-price-{{ai_gen_id}},
  .ai-boomba-viewers-{{ai_gen_id}},
  .ai-boomba-size-buttons-{{ai_gen_id}},
  .ai-boomba-color-swatches-{{ai_gen_id}},
  .ai-boomba-stock-{{ai_gen_id}},
  .ai-boomba-reassurance-{{ai_gen_id}},
  .ai-boomba-atc-wrap-{{ai_gen_id}},
  .ai-boomba-timer-{{ai_gen_id}},
  .ai-boomba-accordion-{{ai_gen_id}},
  .ai-boomba-bundle-wrap-{{ai_gen_id}},
  .ai-boomba-variant-label-{{ai_gen_id}},
  .ai-boomba-compatibility-{{ai_gen_id}},
  .ai-boomba-payment-strip-{{ai_gen_id}} {
    margin-left: 4px;
    margin-right: 4px;
  }

/* ═══ PREMIUM OFFER TITLE ═══ */
.ai-boomba-offer-title-{{ai_gen_id}} {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 18px 4px 16px;
}
.ai-boomba-offer-title-{{ai_gen_id}} .line {
  flex: 1;
  height: 1px;
  background: linear-gradient(to right, transparent, #D9869F, transparent);
}
.ai-boomba-offer-title-{{ai_gen_id}} .text {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 14px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #D9869F;
  font-weight: 600;
}
.ai-boomba-offer-title-{{ai_gen_id}} .crown {
  width: 16px;
  height: 16px;
  opacity: 0.8;
}

  .ai-boomba-image-card-{{ai_gen_id}} {
    background-color: #F4ECEF;
    border: 2px solid #E6A8B3;
    border-radius: 20px;
    padding: 20px;
    position: relative;
    margin-bottom: 16px;
    overflow: hidden;
  }
  .ai-boomba-main-image-{{ai_gen_id}} {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    display: block;
  }
  .ai-boomba-main-video-{{ai_gen_id}} {
    width: 100%;
    height: 320px;
    object-fit: contain;
    display: block;
    background: transparent;
  }
  .ai-boomba-thumb-wrap-{{ai_gen_id}} {
    position: relative;
    flex-shrink: 0;
    width: calc((100vw - 8px - 6 * 8px) / 7.5);
    max-width: 64px;
    min-width: 40px;
    height: calc((100vw - 8px - 6 * 8px) / 7.5);
    max-height: 64px;
    min-height: 40px;
    scroll-snap-align: start;
    cursor: pointer;
  }
  .ai-boomba-thumb-play-{{ai_gen_id}} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .ai-boomba-thumb-play-{{ai_gen_id}} svg {
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,0.5));
  }
  .ai-boomba-thumbnails-wrapper-{{ai_gen_id}} {
    position: relative;
    margin-bottom: 16px;
  }
  .ai-boomba-thumbnails-{{ai_gen_id}} {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }
  .ai-boomba-thumbnails-{{ai_gen_id}}::-webkit-scrollbar { display: none; }
  .ai-boomba-thumbnails-fade-{{ai_gen_id}} {
    position: absolute;
    top: 0; right: 0;
    width: 48px; height: 100%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.92));
    pointer-events: none;
    border-radius: 0 8px 8px 0;
  }
  .ai-boomba-thumbnail-{{ai_gen_id}} {
    width: calc((100vw - 8px - 6 * 8px) / 7.5);
    max-width: 64px;
    min-width: 40px;
    height: calc((100vw - 8px - 6 * 8px) / 7.5);
    max-height: 64px;
    min-height: 40px;
    border-radius: 8px;
    object-fit: cover;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s;
    scroll-snap-align: start;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
  }
  .ai-boomba-thumb-wrap-{{ai_gen_id}} .ai-boomba-thumbnail-{{ai_gen_id}} {
    width: 100%;
    height: 100%;
  }
  .ai-boomba-thumbnail-{{ai_gen_id}}.active { border-color: #111; }
  .ai-boomba-reviews-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    margin-bottom: 16px;
  }
  .ai-boomba-stars-{{ai_gen_id}} { display: flex; gap: 2px; }
  .ai-boomba-star-svg-{{ai_gen_id}} { width: 16px; height: 16px; }
  .ai-boomba-review-count-{{ai_gen_id}} { font-size: 14px; color: #666; }
  .ai-boomba-trust-badge-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    margin-left: 4px;
    flex-shrink: 0;
  }
  .ai-boomba-trust-badge-{{ai_gen_id}} img {
    height: 20px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  .ai-boomba-title-{{ai_gen_id}} {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 34px;
    color: #111111;
    margin: 10px 0;
    line-height: 1.2;
  }
  .ai-boomba-price-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .ai-boomba-price-current-{{ai_gen_id}} {
    font-size: 20px;
    font-weight: 600;
    color: {{ block.settings.price_color }};
  }
  .ai-boomba-price-compare-{{ai_gen_id}} {
    font-size: 16px;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
  }
  .ai-boomba-discount-badge-{{ai_gen_id}} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.3px;
    flex-shrink: 0;
  }
  .ai-boomba-viewers-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: #FAFAFA;
    border-radius: 10px;
    margin-bottom: 20px;
    border: 1px solid #F0F0F0;
  }
  .ai-boomba-viewers-dot-{{ai_gen_id}} {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #22C55E;
    flex-shrink: 0;
    animation: boomba-live-pulse 2s ease-in-out infinite;
  }
  @keyframes boomba-live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
    50% { opacity: 0.8; transform: scale(1.15); box-shadow: 0 0 0 5px rgba(34,197,94,0); }
  }
  .ai-boomba-viewers-avatars-{{ai_gen_id}} { display: flex; flex-direction: row-reverse; }
  .ai-boomba-viewers-avatar-{{ai_gen_id}} {
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 2px solid #FFFFFF;
    background: linear-gradient(135deg, #F6B5C8, #D9869F);
    margin-left: -7px;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 700; color: #FFF;
    flex-shrink: 0;
  }
  .ai-boomba-viewers-avatar-{{ai_gen_id}}:last-child { margin-left: 0; }
  .ai-boomba-viewers-text-{{ai_gen_id}} {
    font-size: 12.5px; color: #666; font-weight: 400;
    line-height: 1.3; flex: 1;
    transition: opacity 0.3s ease;
  }
  .ai-boomba-viewers-text-{{ai_gen_id}}.updating { opacity: 0.4; }
  .ai-boomba-viewers-text-{{ai_gen_id}} strong { color: #111; font-weight: 600; }
  .ai-boomba-variant-label-{{ai_gen_id}} {
    font-size: 14px; font-weight: 600; color: #111;
    margin-bottom: 8px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .ai-boomba-size-guide-link-{{ai_gen_id}} { font-size: 13px; text-decoration: underline; color: #111; }
  .ai-boomba-size-buttons-{{ai_gen_id}} { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .ai-boomba-size-button-{{ai_gen_id}} {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid #DDD;
    background: #FFF; color: #111; font-size: 13px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    position: relative; overflow: hidden;
  }
  .ai-boomba-size-button-{{ai_gen_id}}.selected { background: #111111; color: #FFFFFF; border-color: #111111; }
  .ai-boomba-size-button-{{ai_gen_id}}.soldout,
  .ai-boomba-color-swatch-{{ai_gen_id}}.soldout { opacity: 0.4; cursor: not-allowed; }
  .ai-boomba-size-button-{{ai_gen_id}}.soldout::after {
    content: '';
    position: absolute; top: 50%; left: 50%;
    width: 130%; height: 1.5px;
    background: #999;
    transform: translate(-50%, -50%) rotate(-45deg);
    pointer-events: none;
  }
  .ai-boomba-color-swatch-{{ai_gen_id}}.soldout { position: relative; }
  .ai-boomba-color-swatch-{{ai_gen_id}}.soldout::after {
    content: '';
    position: absolute; top: 50%; left: 50%;
    width: 130%; height: 1.5px;
    background: rgba(0,0,0,0.4);
    transform: translate(-50%, -50%) rotate(-45deg);
    pointer-events: none; border-radius: 2px;
  }
  .ai-boomba-color-swatches-{{ai_gen_id}} { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
  .ai-boomba-color-swatch-{{ai_gen_id}} {
    width: 32px; height: 32px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
  .ai-boomba-color-swatch-{{ai_gen_id}}.is-light { border-color: #D1D5DB; }
  .ai-boomba-color-swatch-{{ai_gen_id}}.selected { outline-color: #111111; transform: scale(1.12); }
  .ai-boomba-color-swatch-{{ai_gen_id}}.selected.is-light { outline-color: #6B7280; }
  .ai-boomba-stock-{{ai_gen_id}} {
    display: none; align-items: center; gap: 7px;
    margin-bottom: 16px;
    animation: boomba-stock-in 0.4s ease;
  }
  .ai-boomba-stock-{{ai_gen_id}}.visible { display: flex; }
  @keyframes boomba-stock-in { from { opacity: 0; } to { opacity: 1; } }
  .ai-boomba-stock-dot-{{ai_gen_id}} {
    width: 7px; height: 7px;
    border-radius: 50%; background: #E05252;
    flex-shrink: 0;
    animation: boomba-dot-pulse 1.4s ease-in-out infinite;
  }
  @keyframes boomba-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.8); }
  }
  .ai-boomba-stock-text-{{ai_gen_id}} { font-size: 13px; font-weight: 500; color: #E05252; line-height: 1; }
  .ai-boomba-stock-text-{{ai_gen_id}} span { font-weight: 700; }
  .ai-boomba-compatibility-{{ai_gen_id}} { font-size: 13px; color: #888; margin-bottom: 16px; }
  .ai-boomba-reassurance-{{ai_gen_id}} {
    display: flex; flex-direction: column; gap: 10px;
    margin-bottom: 18px; padding: 16px;
    background: #FFF9FB; border-radius: 12px;
    border: 1px solid #F0D9E2;
  }
  .ai-boomba-reassurance-item-{{ai_gen_id}} {
    display: flex; align-items: center; gap: 10px;
    font-size: 13px; color: #333; font-weight: 500; line-height: 1.4;
  }
  .ai-boomba-reassurance-item-{{ai_gen_id}} svg { width: 20px; height: 20px; flex-shrink: 0; color: #E6A8B3; }

  /* ── ATC ── */
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} { margin-bottom: 12px; }
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} button[type="submit"],
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} .product-form__submit,
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} [name="add"] {
    width: 100% !important;
    height: 56px !important;
    border-radius: 40px !important;
    background-color: rgb(91, 200, 164) !important;
    color: #FFFFFF !important;
    font-weight: 600 !important;
    font-size: 16px !important;
    letter-spacing: 0.5px !important;
    text-transform: uppercase !important;
    border: none !important;
    cursor: pointer !important;
    transition: background-color 0.2s !important;
    box-shadow: 0 2px 16px rgba(91,200,164,0.35) !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} button[type="submit"]:hover,
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} .product-form__submit:hover,
  .ai-boomba-product-{{ai_gen_id}} .ai-boomba-atc-wrap-{{ai_gen_id}} [name="add"]:hover {
    background-color: rgb(71, 180, 144) !important;
  }

  .ai-boomba-timer-{{ai_gen_id}} {
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px; background: #111111; color: #FFFFFF;
    border-radius: 14px; padding: 14px 20px; margin-bottom: 20px;
  }
  .ai-boomba-timer-left-group-{{ai_gen_id}} { display: flex; align-items: center; gap: 10px; }
  .ai-boomba-timer-dot-{{ai_gen_id}} {
    width: 7px; height: 7px; border-radius: 50%;
    background: #F6B5C8; flex-shrink: 0;
    animation: boomba-dot-blink 1.4s ease-in-out infinite;
  }
  @keyframes boomba-dot-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .ai-boomba-timer-left-{{ai_gen_id}} { display: flex; flex-direction: column; gap: 2px; }
  .ai-boomba-timer-title-{{ai_gen_id}} { font-size: 11px; font-weight: 500; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.8px; }
  .ai-boomba-timer-sub-{{ai_gen_id}} { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.85); }
  .ai-boomba-timer-right-{{ai_gen_id}} { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .ai-boomba-timer-ends-{{ai_gen_id}} { font-size: 10px; font-weight: 500; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.6px; }
  .ai-boomba-timer-countdown-{{ai_gen_id}} {
    font-size: 22px; font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 2px; color: #F6B5C8;
    font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
    line-height: 1;
  }
  .ai-boomba-timer-countdown-{{ai_gen_id}}.urgent { color: #FF6B6B; animation: boomba-timer-urgent 0.7s ease-in-out infinite; }
  @keyframes boomba-timer-urgent { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  .ai-boomba-timer-{{ai_gen_id}}.expired { background: #444; }

  .ai-boomba-accordion-{{ai_gen_id}} {
    background: #F7E6EA; border: 1px solid #F0C9D2;
    border-radius: 12px; padding: 20px; margin-bottom: 20px;
  }
  .ai-boomba-accordion-header-{{ai_gen_id}} { display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
  .ai-boomba-accordion-title-{{ai_gen_id}} { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 16px; color: #111; }
  .ai-boomba-bell-icon-{{ai_gen_id}} { width: 20px; height: 20px; flex-shrink: 0; }
  .ai-boomba-chevron-{{ai_gen_id}} { width: 20px; height: 20px; transition: transform 0.3s ease; flex-shrink: 0; }
  .ai-boomba-chevron-{{ai_gen_id}}.open { transform: rotate(180deg); }
  .ai-boomba-accordion-content-{{ai_gen_id}} { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .ai-boomba-accordion-content-{{ai_gen_id}}.open { max-height: 1000px; margin-top: 16px; }
  .ai-boomba-accordion-text-{{ai_gen_id}} { font-size: 14px; color: #555; margin-bottom: 16px; line-height: 1.6; }
  .ai-boomba-calculator-{{ai_gen_id}} { display: flex; flex-direction: column; gap: 14px; }
  .ai-boomba-input-group-{{ai_gen_id}} { display: flex; flex-direction: column; gap: 6px; }
  .ai-boomba-input-label-{{ai_gen_id}} { font-size: 13px; font-weight: 600; color: #111; }
  .ai-boomba-select-{{ai_gen_id}} { height: 44px; border-radius: 10px; border: 1px solid #DDD; padding: 0 12px; font-size: 14px; background: #FFF; appearance: auto; cursor: pointer; }
  .ai-boomba-breast-buttons-{{ai_gen_id}} { display: flex; gap: 8px; flex-wrap: wrap; }
  .ai-boomba-breast-btn-{{ai_gen_id}} {
    flex: 1; min-width: 80px; height: 56px;
    border-radius: 10px; border: 1px solid #DDD;
    background: #FFF; color: #111; font-size: 13px; font-weight: 500;
    cursor: pointer; transition: all 0.15s;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; padding: 6px 4px;
  }
  .ai-boomba-breast-btn-{{ai_gen_id}} .breast-icon { font-size: 18px; line-height: 1; }
  .ai-boomba-breast-btn-{{ai_gen_id}} .breast-label { font-size: 11px; color: #666; }
  .ai-boomba-breast-btn-{{ai_gen_id}}.selected { background: #F4ECEF; border-color: #E6A8B3; color: #111; }
  .ai-boomba-breast-btn-{{ai_gen_id}}.selected .breast-label { color: #C47A8A; }
  .ai-boomba-result-box-{{ai_gen_id}} {
    display: none; margin-top: 4px;
    background: #FFF; border: 1.5px solid #E6A8B3;
    border-radius: 12px; padding: 16px 20px;
    text-align: center; animation: boomba-fade-in 0.3s ease;
  }
  @keyframes boomba-fade-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  .ai-boomba-result-box-{{ai_gen_id}}.visible { display: block; }
  .ai-boomba-result-label-{{ai_gen_id}} { font-size: 11px; color: #999; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px; }
  .ai-boomba-result-size-{{ai_gen_id}} { font-family: 'Playfair Display', Georgia, serif; font-size: 48px; font-weight: 700; color: #111; line-height: 1; margin-bottom: 6px; }
  .ai-boomba-result-desc-{{ai_gen_id}} { font-size: 13px; color: #888; line-height: 1.4; }
  .ai-boomba-result-counter-{{ai_gen_id}} { margin-top: 8px; font-size: 10px; color: #CCC; letter-spacing: 0.3px; }
  .ai-boomba-help-text-{{ai_gen_id}} { font-size: 13px; color: #555; margin-top: 16px; line-height: 1.6; }
  .ai-boomba-help-text-{{ai_gen_id}} a { text-decoration: underline; color: #555; }
  .ai-boomba-description-{{ai_gen_id}} { font-size: 14px; line-height: 1.6; color: #333; margin-top: 8px; }
  .ai-boomba-payment-strip-{{ai_gen_id}} { margin-bottom: 16px; }
  .ai-boomba-payment-strip-{{ai_gen_id}} img { width: 100%; height: auto; display: block; border-radius: 12px; object-fit: contain; }

  /* ═══ BUNDLE ═══ */
  .ai-boomba-bundle-wrap-{{ai_gen_id}} { margin-bottom: 14px; }
  .ai-boomba-bundle-label-{{ai_gen_id}} {
    font-size: 12px; font-weight: 700;
    letter-spacing: 1.4px; text-transform: uppercase;
    color: #999; margin-bottom: 10px;
  }
  .ai-boomba-bcard-{{ai_gen_id}} {
    position: relative;
    border: 2px solid #E5E7EB;
    border-radius: 18px;
    background: #FFFFFF;
    cursor: pointer;
    transition: border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, transform 0.18s ease;
    overflow: hidden;
    margin-bottom: 12px;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .ai-boomba-bcard-{{ai_gen_id}}:last-child { margin-bottom: 0; }
  .ai-boomba-bcard-{{ai_gen_id}}:not(.selected):hover {
    border-color: #E7D7DD;
    box-shadow: 0 6px 18px rgba(0,0,0,0.05);
    background: #FFFDFE;
