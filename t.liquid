<boomba-product-{{ai_gen_id}} class="ai-boomba-product-{{ai_gen_id}}" data-bundle-theme="premium" {{ block.shopify_attributes }}>

  <div class="ai-boomba-image-card-{{ai_gen_id}}" id="ai-boomba-media-card-{{ai_gen_id}}">
    {%- assign first_media = product.media[0] -%}
    {%- if first_media.media_type == 'video' or first_media.media_type == 'external_video' -%}
      <video class="ai-boomba-main-video-{{ai_gen_id}}" id="ai-boomba-main-image-{{ai_gen_id}}"
        src="{{ first_media.sources[1].url | default: first_media.sources[0].url }}"
        poster="{{ first_media.preview_image | image_url: width: 600 }}"
        autoplay muted loop playsinline>
      </video>
    {%- else -%}
      {%- assign main_img = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
      {% if main_img %}
        <img
          src="{{ main_img | image_url: width: 600 }}"
          srcset="{{ main_img | image_url: width: 400 }} 400w, {{ main_img | image_url: width: 600 }} 600w, {{ main_img | image_url: width: 800 }} 800w"
          sizes="(max-width: 600px) 100vw, 600px"
          alt="{{ main_img.alt | escape }}"
          class="ai-boomba-main-image-{{ai_gen_id}}"
          id="ai-boomba-main-image-{{ai_gen_id}}"
          width="{{ main_img.width }}"
          height="{{ main_img.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async">
      {% else %}
        <div class="ai-boomba-main-image-{{ai_gen_id}}">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endif %}
    {%- endif -%}
  </div>

  {% if product.media.size > 1 %}
    <div class="ai-boomba-thumbnails-wrapper-{{ai_gen_id}}">
      <div class="ai-boomba-thumbnails-{{ai_gen_id}}" id="ai-boomba-thumbs-{{ai_gen_id}}">
        {% for media in product.media limit: 20 %}
          <div class="ai-boomba-thumb-wrap-{{ai_gen_id}}"
            data-media-type="{{ media.media_type }}"
            {% if media.media_type == 'video' or media.media_type == 'external_video' %}
              data-video-src="{{ media.sources[1].url | default: media.sources[0].url }}"
              data-video-poster="{{ media.preview_image | image_url: width: 600 }}"
            {% elsif media.media_type == 'image' %}
              data-image-url="{{ media | image_url: width: 800 }}"
            {% endif %}>
            <img
              src="{{ media.preview_image | image_url: width: 100 }}"
              srcset="{{ media.preview_image | image_url: width: 100 }} 100w, {{ media.preview_image | image_url: width: 150 }} 150w"
              sizes="64px"
              alt="{{ media.alt | escape }}"
              class="ai-boomba-thumbnail-{{ai_gen_id}}{% if forloop.first %} active{% endif %}"
              width="64" height="64"
              loading="lazy"
              decoding="async">
            {% if media.media_type == 'video' or media.media_type == 'external_video' %}
              <div class="ai-boomba-thumb-play-{{ai_gen_id}}">
                <svg viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="12" fill="rgba(0,0,0,0.45)"/>
                  <polygon points="9,7 19,12 9,17" fill="white"/>
                </svg>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if product.media.size > 7 %}
        <div class="ai-boomba-thumbnails-fade-{{ai_gen_id}}"></div>
      {% endif %}
    </div>
  {% endif %}

  <script>
  (function() {
    var GEN = '{{ai_gen_id}}';
    function initCarousel() {
      var card = document.getElementById('ai-boomba-media-card-' + GEN);
      var wrapper = document.getElementById('ai-boomba-thumbs-' + GEN);
      if (!card || !wrapper) return;
      wrapper.addEventListener('click', function(e) {
        var wrap = null;
        var el = e.target;
        while (el && el !== wrapper) {
          if (el.classList && el.classList.contains('ai-boomba-thumb-wrap-' + GEN)) { wrap = el; break; }
          el = el.parentNode;
        }
        if (!wrap) return;
        e.stopPropagation();
        var allThumbs = document.querySelectorAll('.ai-boomba-thumbnail-' + GEN);
        for (var i = 0; i < allThumbs.length; i++) allThumbs[i].classList.remove('active');
        var thumbImg = wrap.querySelector('.ai-boomba-thumbnail-' + GEN);
        if (thumbImg) thumbImg.classList.add('active');
        var type = wrap.getAttribute('data-media-type');
        if (type === 'video' || type === 'external_video') {
          var src = wrap.getAttribute('data-video-src');
          var poster = wrap.getAttribute('data-video-poster');
          card.innerHTML = '';
          var vid = document.createElement('video');
          vid.className = 'ai-boomba-main-video-' + GEN;
          vid.setAttribute('src', src);
          vid.setAttribute('poster', poster);
          vid.autoplay = true; vid.muted = true; vid.loop = true;
          vid.setAttribute('playsinline', '');
          card.appendChild(vid);
          vid.load();
          try { vid.play(); } catch(err) {}
        } else {
          var url = wrap.getAttribute('data-image-url');
          if (!url) return;
          if (url.indexOf('//') === 0) url = 'https:' + url;
          var oldVid = card.querySelector('video');
          if (oldVid) { oldVid.pause(); if (oldVid.parentNode) oldVid.parentNode.removeChild(oldVid); }
          var img = card.querySelector('img');
          if (!img) {
            img = document.createElement('img');
            img.className = 'ai-boomba-main-image-' + GEN;
            img.setAttribute('width', '800');
            img.setAttribute('height', '800');
            img.setAttribute('decoding', 'async');
            card.appendChild(img);
          }
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
          img.setAttribute('src', url);
        }
      }, true);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCarousel);
    } else {
      initCarousel();
    }
  })();
  </script>

  <div class="ai-boomba-reviews-{{ai_gen_id}}">
