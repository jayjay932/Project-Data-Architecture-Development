            {% endif %}
          </div>
        {% endif %}
        {% if block.settings.feat4_show and block.settings.feat4_image != blank %}
          <div class="ai-boomba-feat-card-{{ai_gen_id}}">
            <div class="ai-boomba-feat-img-wrap-{{ai_gen_id}}">
              <img src="{{ block.settings.feat4_image | image_url: width: 128 }}"
                srcset="{{ block.settings.feat4_image | image_url: width: 64 }} 64w, {{ block.settings.feat4_image | image_url: width: 128 }} 128w"
                sizes="64px" alt="{{ block.settings.feat4_label | escape }}"
                class="ai-boomba-feat-img-{{ai_gen_id}}"
                width="64" height="64" loading="lazy" decoding="async">
            </div>
            {% if block.settings.feat4_label != blank %}
              <span class="ai-boomba-feat-label-{{ai_gen_id}}">{{ block.settings.feat4_label }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% for option in product.options_with_values %}
      {% assign option_name_lower = option.name | downcase %}
      {% if option_name_lower contains 'color' or option_name_lower contains 'colour' or option_name_lower contains 'couleur' %}
        <div class="ai-boomba-variant-label-{{ai_gen_id}}"><span>{{ option.name }}</span></div>
        <div class="ai-boomba-color-swatches-{{ai_gen_id}}">
          {% for value in option.values %}
            {% assign color_label = value | downcase | strip | replace: ' ', '-' %}
            {% assign hex = '' %}
            {% case color_label %}
              {% when 'noir', 'black', 'negro' %}{% assign hex = '#111111' %}
              {% when 'blanc', 'white', 'blanco' %}{% assign hex = '#FFFFFF' %}
              {% when 'gris', 'grey', 'gray', 'gris-clair' %}{% assign hex = '#9CA3AF' %}
              {% when 'gris-fonce', 'dark-grey', 'dark-gray' %}{% assign hex = '#4B5563' %}
              {% when 'rose', 'pink' %}{% assign hex = '#F4A7B9' %}
              {% when 'rose-pale', 'blush', 'light-pink' %}{% assign hex = '#FADADD' %}
              {% when 'nude', 'beige', 'skin', 'chair' %}{% assign hex = '#E8C9A0' %}
              {% when 'nude-fonce', 'dark-nude', 'mocha' %}{% assign hex = '#C4956A' %}
              {% when 'ivoire', 'ivory', 'marfil', 'creme' %}{% assign hex = '#FFF8F0' %}
              {% when 'rouge', 'red', 'rojo' %}{% assign hex = '#DC2626' %}
              {% when 'bordeaux', 'burgundy', 'wine', 'vino' %}{% assign hex = '#7F1D1D' %}
              {% when 'orange' %}{% assign hex = '#F97316' %}
              {% when 'jaune', 'yellow', 'amarillo' %}{% assign hex = '#FACC15' %}
              {% when 'vert', 'green', 'verde' %}{% assign hex = 'rgb(91, 200, 164)' %}
              {% when 'bleu', 'blue', 'azul' %}{% assign hex = '#2563EB' %}
              {% when 'bleu-ciel', 'sky', 'light-blue' %}{% assign hex = '#7DD3FC' %}
              {% when 'marine', 'navy', 'marino' %}{% assign hex = '#1E3A5F' %}
              {% when 'violet', 'purple', 'morado' %}{% assign hex = '#7C3AED' %}
              {% when 'lilas', 'lilac', 'lavande', 'lavender' %}{% assign hex = '#C4B5FD' %}
              {% when 'marron', 'brown', 'cafe', 'camel' %}{% assign hex = '#92400E' %}
              {% when 'leopard', 'animal-print' %}{% assign hex = '#C8922A' %}
              {% else %}{% assign hex = value | downcase | strip %}
            {% endcase %}
            {% assign is_light = false %}
            {% if color_label == 'blanc' or color_label == 'white' or color_label == 'blanco'
              or color_label == 'ivoire' or color_label == 'ivory' or color_label == 'marfil' or color_label == 'creme'
              or color_label == 'rose-pale' or color_label == 'blush' or color_label == 'light-pink'
              or color_label == 'nude' or color_label == 'beige' or color_label == 'skin' or color_label == 'chair'
              or color_label == 'jaune' or color_label == 'yellow' or color_label == 'amarillo' %}
              {% assign is_light = true %}
            {% endif %}
            {% assign option_soldout = true %}
            {% for variant in product.variants %}
              {% assign opt_key = 'option' | append: option.position %}
              {% if variant[opt_key] == value and variant.available %}{% assign option_soldout = false %}{% endif %}
            {% endfor %}
            <button type="button"
              class="ai-boomba-color-swatch-{{ai_gen_id}}{% if option.selected_value == value %} selected{% endif %}{% if is_light %} is-light{% endif %}{% if option_soldout %} soldout{% endif %}"
              style="background-color: {{ hex }};"
              data-option-position="{{ option.position }}"
              data-value="{{ value | escape }}"
              {% if option_soldout %}disabled{% endif %}
              title="{{ value }}{% if option_soldout %} — Agotado{% endif %}"
              aria-label="{{ value }}{% if option_soldout %} — Agotado{% endif %}"></button>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-boomba-variant-label-{{ai_gen_id}}">
          <span>{{ option.name }}</span>
          {% if option_name_lower contains 'size' or option_name_lower contains 'talla' %}
            {% if block.settings.size_guide_link != blank %}
              <a href="{{ block.settings.size_guide_link }}" class="ai-boomba-size-guide-link-{{ai_gen_id}}">Tabla De Tallas</a>
            {% endif %}
          {% endif %}
        </div>
        <div class="ai-boomba-size-buttons-{{ai_gen_id}}">
          {% for value in option.values %}
            {% assign option_soldout = true %}
            {% for variant in product.variants %}
              {% assign opt_key = 'option' | append: option.position %}
              {% if variant[opt_key] == value and variant.available %}{% assign option_soldout = false %}{% endif %}
            {% endfor %}
            <button type="button"
              class="ai-boomba-size-button-{{ai_gen_id}}{% if option.selected_value == value %} selected{% endif %}{% if option_soldout %} soldout{% endif %}"
              data-option-position="{{ option.position }}"
              data-value="{{ value | escape }}"
              {% if option_soldout %}disabled{% endif %}>{{ value }}</button>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}

    <div class="ai-boomba-stock-{{ai_gen_id}}" id="ai-boomba-stock-{{ai_gen_id}}">
      <div class="ai-boomba-stock-dot-{{ai_gen_id}}"></div>
      <div class="ai-boomba-stock-text-{{ai_gen_id}}">
        Solo quedan <span id="ai-boomba-stock-count-{{ai_gen_id}}">3</span> unidades en Stock
      </div>
    </div>

    {% if block.settings.compatibility_text != blank %}
      <div class="ai-boomba-compatibility-{{ai_gen_id}}">{{ block.settings.compatibility_text }}</div>
    {% endif %}

    {% if block.settings.show_size_guide %}
      <div class="ai-boomba-accordion-{{ai_gen_id}}">
        <div class="ai-boomba-accordion-header-{{ai_gen_id}}" id="ai-boomba-accordion-toggle-{{ai_gen_id}}">
          <div class="ai-boomba-accordion-title-{{ai_gen_id}}">
            <svg class="ai-boomba-bell-icon-{{ai_gen_id}}" fill="none" stroke="#111" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
            <span>{{ block.settings.accordion_title }}</span>
          </div>
          <svg class="ai-boomba-chevron-{{ai_gen_id}}" fill="none" stroke="#111" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
        <div class="ai-boomba-accordion-content-{{ai_gen_id}}" id="ai-boomba-accordion-content-{{ai_gen_id}}">
          {% if block.settings.accordion_description != blank %}
            <div class="ai-boomba-accordion-text-{{ai_gen_id}}">{{ block.settings.accordion_description }}</div>
          {% endif %}
          <div class="ai-boomba-calculator-{{ai_gen_id}}">
            <div class="ai-boomba-input-group-{{ai_gen_id}}">
              <label class="ai-boomba-input-label-{{ai_gen_id}}">Tu peso</label>
              <select class="ai-boomba-select-{{ai_gen_id}}" id="ai-boomba-peso-{{ai_gen_id}}">
                <option value="">Seleccionar tu peso</option>
                <option value="xs">Menos de 55 kg</option>
                <option value="s">55 – 65 kg</option>
                <option value="m">66 – 75 kg</option>
                <option value="l">76 – 90 kg</option>
                <option value="xl">Más de 90 kg</option>
              </select>
            </div>
            <div class="ai-boomba-input-group-{{ai_gen_id}}">
              <label class="ai-boomba-input-label-{{ai_gen_id}}">Seleccionar Tamaño de pecho</label>
              <div class="ai-boomba-breast-buttons-{{ai_gen_id}}">
                <button type="button" class="ai-boomba-breast-btn-{{ai_gen_id}}" data-breast="small">
                  <span class="breast-icon">🔵</span><span class="breast-label">Pequeño</span>
                </button>
                <button type="button" class="ai-boomba-breast-btn-{{ai_gen_id}}" data-breast="medium">
                  <span class="breast-icon">🟣</span><span class="breast-label">Mediano</span>
                </button>
                <button type="button" class="ai-boomba-breast-btn-{{ai_gen_id}}" data-breast="large">
                  <span class="breast-icon">🔴</span><span class="breast-label">Grande</span>
                </button>
              </div>
            </div>
            <div class="ai-boomba-result-box-{{ai_gen_id}}" id="ai-boomba-result-{{ai_gen_id}}"
              data-counter-enabled="{{ block.settings.show_size_counter }}"
              data-counter-start="{{ block.settings.size_counter_start | default: 10000 }}">
              <div class="ai-boomba-result-label-{{ai_gen_id}}">Tu talla BOOMBA</div>
              <div class="ai-boomba-result-size-{{ai_gen_id}}" id="ai-boomba-result-size-{{ai_gen_id}}">—</div>
              <div class="ai-boomba-result-desc-{{ai_gen_id}}" id="ai-boomba-result-desc-{{ai_gen_id}}"></div>
              {% if block.settings.show_size_counter %}
                <div class="ai-boomba-result-counter-{{ai_gen_id}}" id="ai-boomba-result-counter-{{ai_gen_id}}"></div>
              {% endif %}
            </div>
          </div>
          {% if block.settings.help_text != blank %}
            <div class="ai-boomba-help-text-{{ai_gen_id}}">{{ block.settings.help_text }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_bundles %}
      {% assign bundle2_product = all_products[block.settings.bundle_product_handle] %}
      {% assign bundle2_variant = bundle2_product.selected_or_first_available_variant %}
      {% assign bundle2_price = bundle2_variant.price | default: 0 %}
      {% assign main_price = product.selected_or_first_available_variant.price %}
      {% assign bundle2_total = main_price | plus: bundle2_price %}
      <div class="ai-boomba-bundle-wrap-{{ai_gen_id}}" id="ai-boomba-bundle-{{ai_gen_id}}"
        data-bundle2-id="{{ bundle2_variant.id }}"
        data-bundle2-price="{{ bundle2_price }}"
        data-bundle2-total="{{ bundle2_total }}"
        data-bundle2-compare="{{ block.settings.bundle2_compare_price | times: 100 }}"
        data-currency="{{ cart.currency.iso_code }}"
        data-locale="{{ localization.language.iso_code }}"
        data-bundle1-shipping-free="{{ block.settings.bundle1_free_shipping }}"
        data-bundle1-shipping-cost="{{ block.settings.bundle1_shipping_cost }}"
        data-bundle1-perk="{{ block.settings.bundle1_perk }}"
        data-bundle2-shipping-free="{{ block.settings.bundle2_free_shipping }}"
        data-bundle2-shipping-cost="{{ block.settings.bundle2_shipping_cost }}"
        data-bundle2-perk="{{ block.settings.bundle2_perk }}"
        data-delivery-min="{{ block.settings.delivery_days_min | default: 2 }}"
        data-delivery-max="{{ block.settings.delivery_days_max | default: 5 }}">
        <div class="ai-boomba-offer-title-{{ai_gen_id}}">
          <span class="line"></span>
          <span class="text">
            <svg class="crown" viewBox="0 0 24 24" fill="none">
              <path d="M3 9l3 3 6-6 6 6 3-3v9H3V9z" fill="#D9869F"/>
            </svg>
            {{ block.settings.bundle_section_label }}
          </span>
          <span class="line"></span>
        </div>
        <div class="ai-boomba-bcard-{{ai_gen_id}} selected" data-bundle="1" id="ai-boomba-bcard1-{{ai_gen_id}}">
          <div class="ai-boomba-bcard-inner-{{ai_gen_id}}">
            <div class="ai-boomba-bradio-{{ai_gen_id}}"><div class="ai-boomba-bradio-dot-{{ai_gen_id}}"></div></div>
            <div class="ai-boomba-bimgs-{{ai_gen_id}}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 100 }}"
                  srcset="{{ product.featured_image | image_url: width: 100 }} 100w, {{ product.featured_image | image_url: width: 120 }} 120w"
                  sizes="48px" alt="{{ product.featured_image.alt | escape }}"
                  class="ai-boomba-bimg-{{ai_gen_id}}" width="48" height="48" loading="lazy" decoding="async">
              {% else %}
                <div class="ai-boomba-bimg-placeholder-{{ai_gen_id}}">👙</div>
              {% endif %}
            </div>
            <div class="ai-boomba-btext-{{ai_gen_id}}">
              <div class="ai-boomba-btitle-{{ai_gen_id}}">{{ block.settings.bundle1_title | default: '1 Pack' }}</div>
              <div class="ai-boomba-delivery-date-{{ai_gen_id}}" id="ai-boomba-b1delivery-{{ai_gen_id}}"></div>
              {% if block.settings.bundle1_save_text != blank %}
                <span class="ai-boomba-bsave-{{ai_gen_id}}">{{ block.settings.bundle1_save_text }}</span>
              {% endif %}
            </div>
            <div class="ai-boomba-bprice-{{ai_gen_id}} ai-boomba-bprice-b1-{{ai_gen_id}}">
              <span class="ai-boomba-bprice-current-{{ai_gen_id}}" id="ai-boomba-b1price-{{ai_gen_id}}">{{ main_price | money }}</span>
              {% if product.selected_or_first_available_variant.compare_at_price > main_price %}
                <span class="ai-boomba-bprice-compare-{{ai_gen_id}}">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="ai-boomba-bcard-{{ai_gen_id}}" data-bundle="2" id="ai-boomba-bcard2-{{ai_gen_id}}">
          {% if block.settings.bundle2_badge != blank %}
            <div class="ai-boomba-bbest-{{ai_gen_id}}">{{ block.settings.bundle2_badge }}</div>
          {% endif %}
          <div class="ai-boomba-bcard-inner-{{ai_gen_id}}">
            <div class="ai-boomba-bradio-{{ai_gen_id}}"><div class="ai-boomba-bradio-dot-{{ai_gen_id}}"></div></div>
            <div class="ai-boomba-bimgs-{{ai_gen_id}}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 100 }}"
                  srcset="{{ product.featured_image | image_url: width: 100 }} 100w, {{ product.featured_image | image_url: width: 120 }} 120w"
                  sizes="48px" alt="{{ product.featured_image.alt | escape }}"
                  class="ai-boomba-bimg-{{ai_gen_id}}" width="48" height="48" loading="lazy" decoding="async">
              {% else %}
                <div class="ai-boomba-bimg-placeholder-{{ai_gen_id}}">👙</div>
              {% endif %}
              <span class="ai-boomba-bimg-plus-{{ai_gen_id}}">+</span>
              {% if bundle2_product.featured_image %}
                <img src="{{ bundle2_product.featured_image | image_url: width: 100 }}"
                  srcset="{{ bundle2_product.featured_image | image_url: width: 100 }} 100w, {{ bundle2_product.featured_image | image_url: width: 120 }} 120w"
                  sizes="48px" alt="{{ bundle2_product.title | escape }}"
                  class="ai-boomba-bimg-{{ai_gen_id}}" width="48" height="48" loading="lazy" decoding="async">
              {% else %}
                <div class="ai-boomba-bimg-placeholder-{{ai_gen_id}}">🎁</div>
              {% endif %}
            </div>
            <div class="ai-boomba-btext-{{ai_gen_id}}">
              <div class="ai-boomba-btitle-{{ai_gen_id}}">{{ block.settings.bundle2_title | default: '2 Pack' }}</div>
              <div class="ai-boomba-delivery-date-{{ai_gen_id}}" id="ai-boomba-b2delivery-{{ai_gen_id}}"></div>
              {% if block.settings.bundle2_save_text != blank %}
                <span class="ai-boomba-bsave-{{ai_gen_id}}">{{ block.settings.bundle2_save_text }}</span>
              {% endif %}
            </div>
            <div class="ai-boomba-bprice-{{ai_gen_id}} ai-boomba-bprice-b2-{{ai_gen_id}}">
              <span class="ai-boomba-bprice-current-{{ai_gen_id}}" id="ai-boomba-b2price-{{ai_gen_id}}">{{ bundle2_total | money }}</span>
              {% if block.settings.bundle2_compare_price > 0 %}
                <span class="ai-boomba-bprice-compare-{{ai_gen_id}}" id="ai-boomba-b2compare-{{ai_gen_id}}">{{ block.settings.bundle2_compare_price | times: 100 | money }}</span>
              {% endif %}
            </div>
          </div>
          {% if block.settings.bundle2_bonus_text != blank %}
            <div class="ai-boomba-bbonus-{{ai_gen_id}}">
              {% if block.settings.bundle2_bonus_image != blank %}
                <img src="{{ block.settings.bundle2_bonus_image | image_url: width: 80 }}"
                  alt="bonus" class="ai-boomba-bbonus-img-{{ai_gen_id}}"
                  width="32" height="32" loading="lazy" decoding="async">
              {% else %}
                <div class="ai-boomba-bbonus-placeholder-{{ai_gen_id}}">🎁</div>
              {% endif %}
              <div class="ai-boomba-bbonus-text-{{ai_gen_id}}">{{ block.settings.bundle2_bonus_text }}</div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="ai-boomba-atc-wrap-{{ai_gen_id}}" id="ai-boomba-atc-anchor-{{ai_gen_id}}">
      <button type="submit" name="add"
        class="product-form__submit button button--full-width button--primary"
        {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
        <span>
          {% if product.selected_or_first_available_variant.available %}
            {{ block.settings.add_to_cart_text }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </span>
      </button>
    </div>
  {% endform %}

  {% if block.settings.show_timer %}
    <div class="ai-boomba-timer-{{ai_gen_id}}" id="ai-boomba-timer-{{ai_gen_id}}"
      data-minutes="{{ block.settings.timer_minutes }}"
      data-reset="{{ block.settings.timer_reset }}">
      <div class="ai-boomba-timer-left-group-{{ai_gen_id}}">
        <div class="ai-boomba-timer-dot-{{ai_gen_id}}"></div>
        <div class="ai-boomba-timer-left-{{ai_gen_id}}">
          <span class="ai-boomba-timer-title-{{ai_gen_id}}">{{ block.settings.timer_label }}</span>
          <span class="ai-boomba-timer-sub-{{ai_gen_id}}">{{ block.settings.timer_ends_text }}</span>
        </div>
      </div>
      <div class="ai-boomba-timer-right-{{ai_gen_id}}">
        <span class="ai-boomba-timer-ends-{{ai_gen_id}}">Tiempo restante</span>
        <span class="ai-boomba-timer-countdown-{{ai_gen_id}}" id="ai-boomba-countdown-{{ai_gen_id}}">--:--</span>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_payment_strip and block.settings.payment_strip_image != blank %}
    <div class="ai-boomba-payment-strip-{{ai_gen_id}}">
      <img src="{{ block.settings.payment_strip_image | image_url: width: 600 }}"
        srcset="{{ block.settings.payment_strip_image | image_url: width: 400 }} 400w, {{ block.settings.payment_strip_image | image_url: width: 600 }} 600w"
        sizes="(max-width: 600px) 100vw, 600px"
        alt="{{ block.settings.payment_strip_alt | default: 'Paiement sécurisé' | escape }}"
        width="600" height="150" loading="lazy" decoding="async">
    </div>
  {% endif %}

  {% if block.settings.show_reassurance %}
    <div class="ai-boomba-reassurance-{{ai_gen_id}}">
      {% if block.settings.reassurance_1 != blank %}
        <div class="ai-boomba-reassurance-item-{{ai_gen_id}}">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span>{{ block.settings.reassurance_1 }}</span>
        </div>
      {% endif %}
      {% if block.settings.reassurance_2 != blank %}
        <div class="ai-boomba-reassurance-item-{{ai_gen_id}}">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8 8-4-4"/></svg>
          <span>{{ block.settings.reassurance_2 }}</span>
        </div>
      {% endif %}
      {% if block.settings.reassurance_3 != blank %}
        <div class="ai-boomba-reassurance-item-{{ai_gen_id}}">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>{{ block.settings.reassurance_3 }}</span>
        </div>
      {% endif %}
      {% if block.settings.reassurance_4 != blank %}
        <div class="ai-boomba-reassurance-item-{{ai_gen_id}}">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          <span>{{ block.settings.reassurance_4 }}</span>
        </div>
      {% endif %}
      {% if block.settings.reassurance_5 != blank %}
        <div class="ai-boomba-reassurance-item-{{ai_gen_id}}">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span>{{ block.settings.reassurance_5 }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if product.description != blank %}
    <div class="ai-boomba-description-{{ai_gen_id}}">{{ product.description }}</div>
  {% endif %}

</boomba-product-{{ai_gen_id}}>

<script>
(function () {

  var GEN = '{{ai_gen_id}}';

  /* ── STICKY BAR ── */
  (function() {
    var anchor = document.getElementById('ai-boomba-atc-anchor-' + GEN);
    if (!anchor) return;
    var bar = document.createElement('div');
    bar.id = 'ai-boomba-sticky-bar-' + GEN;
    var imgSrc = '{{ product.featured_image | image_url: width: 100 }}';
    var imgAlt = {{ product.featured_image.alt | default: product.title | json }};
    var productTitle = {{ product.title | truncate: 30 | json }};
    var initialPrice = {{ product.selected_or_first_available_variant.price | money | json }};
    var atcText = {{ block.settings.add_to_cart_text | json }};
    var isAvailable = {{ product.selected_or_first_available_variant.available | json }};
    bar.innerHTML = [
      imgSrc ? '<img class="boomba-simg" src="' + imgSrc + '" alt="' + imgAlt + '" width="44" height="44" loading="lazy">' : '',
      '<div class="boomba-sinfo">',
        '<div class="boomba-stitle">' + productTitle + '</div>',
        '<div class="boomba-sprice" id="boomba-sticky-price-' + GEN + '">' + initialPrice + '</div>',
      '</div>',
      '<button class="boomba-sbtn" id="boomba-sticky-btn-' + GEN + '" type="button"' + (!isAvailable ? ' disabled' : '') + '>',
        atcText,
      '</button>'
    ].join('');
    document.body.appendChild(bar);
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        var rect = anchor.getBoundingClientRect();
        var isVisible = rect.bottom > 0 && rect.top < window.innerHeight;
        if (isVisible) bar.classList.remove('boomba-sticky-visible');
        else bar.classList.add('boomba-sticky-visible');
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    var sBtn = document.getElementById('boomba-sticky-btn-' + GEN);
    if (sBtn) {
      sBtn.addEventListener('click', function() {
        var rect = anchor.getBoundingClientRect();
        if (rect.top > window.innerHeight) {
          anchor.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          var submitBtn = anchor.querySelector('[name="add"]');
          if (submitBtn && !submitBtn.disabled) submitBtn.click();
        }
      });
    }
  })();

  /* ── DELIVERY DATE ── */
  (function() {
    var bundleWrap = document.getElementById('ai-boomba-bundle-' + GEN);
    if (!bundleWrap) return;
    var daysMin = parseInt(bundleWrap.dataset.deliveryMin) || 2;
    var daysMax = parseInt(bundleWrap.dataset.deliveryMax) || 5;
    function addBusinessDays(date, n) {
      var d = new Date(date); var added = 0;
      while (added < n) { d.setDate(d.getDate() + 1); var day = d.getDay(); if (day !== 0 && day !== 6) added++; }
      return d;
    }
    function fmtDate(d) {
      var locale = navigator.language || 'es-ES';
      try { return d.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }); }
      catch(e) { return d.getDate() + '/' + (d.getMonth()+1); }
    }
    var now = new Date();
    var rangeText = fmtDate(addBusinessDays(now, daysMin)) + ' – ' + fmtDate(addBusinessDays(now, daysMax));
    function buildDeliveryHtml(isFree, cost, perk) {
      var html = '<span class="delivery-label">Entrega: </span><span class="delivery-range">' + rangeText + '</span>';
      if (isFree) html += ' · <span class="delivery-free">✓ Gratis</span>';
      else if (cost) html += ' · <span class="delivery-cost">' + cost + '</span>';
      if (perk) html += '<br><span class="delivery-label">' + perk + '</span>';
      return html;
    }
    var b1el = document.getElementById('ai-boomba-b1delivery-' + GEN);
    if (b1el) b1el.innerHTML = buildDeliveryHtml(bundleWrap.dataset.bundle1ShippingFree === 'true', (bundleWrap.dataset.bundle1ShippingCost || '').trim(), (bundleWrap.dataset.bundle1Perk || '').trim());
    var b2el = document.getElementById('ai-boomba-b2delivery-' + GEN);
    if (b2el) b2el.innerHTML = buildDeliveryHtml(bundleWrap.dataset.bundle2ShippingFree === 'true', (bundleWrap.dataset.bundle2ShippingCost || '').trim(), (bundleWrap.dataset.bundle2Perk || '').trim());
  })();

  /* ── META PIXEL ── */
  (function() {
    var _variants = {{ product.variants | json }};
    var _productTitle = {{ product.title | json }};
    var _currency = {{ cart.currency.iso_code | json }};
    var _fired = false;
    function firePixel(variantId, qty) {
      if (typeof fbq === 'undefined') return;
      var v = _variants.find(function(x) { return x.id === parseInt(variantId); });
      if (!v) return;
      fbq('track', 'AddToCart', { content_ids: [String(v.id)], content_type: 'product_group', content_name: _productTitle, contents: [{ content_id: String(v.id), quantity: qty || 1 }], currency: _currency, value: parseFloat((v.price / 100).toFixed(2)) });
    }
    document.addEventListener('cart:add', function(e) { var item = e.detail && e.detail.items && e.detail.items[0]; if (!item) return; _fired = true; firePixel(item.variant_id, item.quantity); });
    document.addEventListener('submit', function(e) {
      var form = e.target; if (!form) return;
      var action = form.getAttribute('action') || '';
      if (action.indexOf('/cart/add') === -1) return;
      _fired = false;
      var variantInput = form.querySelector('[name="id"]');
      var qtyInput = form.querySelector('[name="quantity"]');
      if (!variantInput) return;
      setTimeout(function() { if (!_fired) firePixel(variantInput.value, qtyInput ? parseInt(qtyInput.value) || 1 : 1); _fired = false; }, 800);
    }, true);
  })();

  /* ── VIEWERS ── */
  (function() {
    var wrap = document.getElementById('ai-boomba-viewers-' + GEN);
    if (!wrap) return;
    var maxV = parseInt(wrap.dataset.max) || 20;
    var intervalSec = parseInt(wrap.dataset.interval) || 5;
    var countEl = document.getElementById('ai-boomba-viewers-count-' + GEN);
    var textEl = document.getElementById('ai-boomba-viewers-text-' + GEN);
    var current = Math.floor(Math.random() * maxV) + 1;
    function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
    function update() {
      current = Math.max(1, Math.min(maxV, current + rand(-3, 3)));
      if (textEl) textEl.classList.add('updating');
      setTimeout(function() { if (countEl) countEl.textContent = current; if (textEl) textEl.classList.remove('updating'); }, 300);
    }
    if (countEl) countEl.textContent = current;
    setInterval(update, intervalSec * 1000);
  })();

  /* ── TIMER ── */
  (function() {
    var timerEl = document.getElementById('ai-boomba-timer-' + GEN);
    var countEl = document.getElementById('ai-boomba-countdown-' + GEN);
    if (!timerEl || !countEl) return;
    var minutes = parseInt(timerEl.dataset.minutes) || 10;
    var shouldReset = timerEl.dataset.reset === 'true';
    var storageKey = 'boomba_timer_end_' + GEN;
    var totalSeconds = minutes * 60;
    var endTime;
    var stored = sessionStorage.getItem(storageKey);
    if (stored && !shouldReset) {
      endTime = parseInt(stored);
      if (endTime < Date.now()) { endTime = Date.now() + totalSeconds * 1000; sessionStorage.setItem(storageKey, endTime); }
    } else { endTime = Date.now() + totalSeconds * 1000; sessionStorage.setItem(storageKey, endTime); }
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var rem = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
      var h = Math.floor(rem / 3600), m = Math.floor((rem % 3600) / 60), s = rem % 60;
      countEl.textContent = (h > 0 ? pad(h) + ':' : '') + pad(m) + ':' + pad(s);
      if (rem <= 120) countEl.classList.add('urgent'); else countEl.classList.remove('urgent');
      if (rem <= 0) {
        timerEl.classList.add('expired'); clearInterval(interval);
        if (shouldReset) { endTime = Date.now() + totalSeconds * 1000; sessionStorage.setItem(storageKey, endTime); timerEl.classList.remove('expired'); countEl.classList.remove('urgent'); interval = setInterval(tick, 1000); }
      }
    }
    var interval = setInterval(tick, 1000); tick();
  })();

  /* ── CUSTOM ELEMENT ── */
  class BoombaProduct extends HTMLElement {
    constructor() {
      super();
      this.variantData = {{ product.variants | json }};
      this.currentOptions = {};
      {% for option in product.options_with_values %}
        this.currentOptions['option{{ option.position }}'] = {{ option.selected_value | json }};
      {% endfor %}
      this.sizeTable = {
        xs: { small:{size:'A',desc:'Pecho pequeño, peso ligero'}, medium:{size:'A',desc:'Pecho mediano, peso ligero'}, large:{size:'B',desc:'Pecho grande, peso ligero'} },
        s:  { small:{size:'A',desc:'Pecho pequeño, peso S'},      medium:{size:'B',desc:'Pecho mediano, peso S'},      large:{size:'B',desc:'Pecho grande, peso S'} },
        m:  { small:{size:'B',desc:'Pecho pequeño, peso M'},      medium:{size:'B',desc:'Pecho mediano, peso M'},      large:{size:'C',desc:'Pecho grande, peso M'} },
        l:  { small:{size:'B',desc:'Pecho pequeño, peso L'},      medium:{size:'C',desc:'Pecho mediano, peso L'},      large:{size:'C',desc:'Pecho grande, peso L'} },
        xl: { small:{size:'C',desc:'Pecho pequeño, peso XL'},     medium:{size:'C',desc:'Pecho mediano, peso XL'},     large:{size:'D',desc:'Pecho grande, peso XL'} }
      };
      this._peso = null; this._breast = null;
      this._selectedBundle = 1; this._bundle2VariantId = null;
      this._sizeCounterDone = false;
    }

    connectedCallback() {
  this._setupVariantButtons();
  this._setupAccordion();
  this._setupCalculator();
  this._initStock();
  this._setupBundles();
  this._selectedBundle = 1;
  this._onBundleChange();
}
    _setupVariantButtons() {
      this.querySelectorAll('[data-option-position]').forEach(btn => {
        if (btn.disabled) return;
        btn.addEventListener('click', () => {
          const pos = btn.dataset.optionPosition;
          this.querySelectorAll('[data-option-position="' + pos + '"]').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          this.currentOptions['option' + pos] = btn.dataset.value;
          this._updateVariant();
        });
      });
    }

    _updateVariant() {
      const match = this.variantData.find(v =>
        (!this.currentOptions.option1 || v.option1 === this.currentOptions.option1) &&
        (!this.currentOptions.option2 || v.option2 === this.currentOptions.option2) &&
        (!this.currentOptions.option3 || v.option3 === this.currentOptions.option3)
      );
      if (!match) return;
      const idInput = this.querySelector('#ai-boomba-variant-id-' + GEN);
      if (idInput) idInput.value = match.id;
      const fmt = (cents) => {
        try { return new Intl.NumberFormat('{{ localization.language.iso_code }}', { style: 'currency', currency: '{{ cart.currency.iso_code }}' }).format(cents / 100); }
        catch(e) { return (cents / 100).toFixed(2); }
      };
      const priceEl = this.querySelector('#ai-boomba-price-current-' + GEN);
      const compareEl = this.querySelector('#ai-boomba-price-compare-' + GEN);
      if (priceEl) priceEl.textContent = fmt(match.price);
      if (compareEl) {
        if (match.compare_at_price && match.compare_at_price > match.price) { compareEl.textContent = fmt(match.compare_at_price); compareEl.style.display = ''; }
        else { compareEl.textContent = ''; compareEl.style.display = 'none'; }
      }
      const stickyPrice = document.getElementById('boomba-sticky-price-' + GEN);
      if (stickyPrice) stickyPrice.textContent = fmt(match.price);
      const stickyBtn = document.getElementById('boomba-sticky-btn-' + GEN);
      if (stickyBtn) stickyBtn.disabled = !match.available;
      requestAnimationFrame(() => {
        const card = document.getElementById('ai-boomba-media-card-' + GEN);
        if (card && match.featured_image && match.featured_image.src) {
          const vid = card.querySelector('video');
          if (vid) { vid.pause(); vid.remove(); }
          let img = card.querySelector('img');
          if (!img) {
            img = document.createElement('img');
            img.className = 'ai-boomba-main-image-' + GEN;
            img.id = 'ai-boomba-main-image-' + GEN;
            img.width = 800; img.height = 800; img.decoding = 'async';
            card.appendChild(img);
          }
          img.src = match.featured_image.src;
        }
      });
      const atcBtn = this.querySelector('[name="add"]');
      if (atcBtn) {
        const span = atcBtn.querySelector('span');
        if (match.available) { atcBtn.disabled = false; if (span) span.textContent = {{ block.settings.add_to_cart_text | json }}; }
        else { atcBtn.disabled = true; if (span) span.textContent = {{ 'products.product.sold_out' | t | json }}; }
      }
      const b1price = this.querySelector('#ai-boomba-b1price-' + GEN);
      if (b1price) b1price.textContent = fmt(match.price);
      const bundleWrap = this.querySelector('#ai-boomba-bundle-' + GEN);
      if (bundleWrap) {
        const b2raw = parseInt(bundleWrap.dataset.bundle2Price) || 0;
        const b2total = match.price + b2raw;
        bundleWrap.dataset.bundle2Total = b2total;
        const b2priceEl = this.querySelector('#ai-boomba-b2price-' + GEN);
        if (b2priceEl) b2priceEl.textContent = fmt(b2total);
      }
      this._updateStock(match.id);
    }

    _initStock() {
      const idInput = this.querySelector('#ai-boomba-variant-id-' + GEN);
      if (idInput) this._updateStock(parseInt(idInput.value));
    }

    _updateStock(variantId) {
      const stockData = window.__boombaStock_{{ai_gen_id}} || {};
      const stockBadge = this.querySelector('#ai-boomba-stock-' + GEN);
      const stockCount = this.querySelector('#ai-boomba-stock-count-' + GEN);
      if (!stockBadge) return;
      const qty = parseInt(stockData[String(variantId)]) || 0;
      if (qty <= 0) { stockBadge.classList.remove('visible'); return; }
      if (stockCount) stockCount.textContent = qty;
      stockBadge.classList.add('visible');
    }

    _setupAccordion() {
      const header = this.querySelector('#ai-boomba-accordion-toggle-' + GEN);
      const content = this.querySelector('#ai-boomba-accordion-content-' + GEN);
      const chevron = this.querySelector('.ai-boomba-chevron-' + GEN);
      if (!header || !content) return;
      content.classList.add('open'); if (chevron) chevron.classList.add('open');
      header.addEventListener('click', () => { content.classList.toggle('open'); if (chevron) chevron.classList.toggle('open'); });
    }

    _setupCalculator() {
      const pesoSelect = this.querySelector('#ai-boomba-peso-' + GEN);
      if (pesoSelect) { pesoSelect.addEventListener('change', () => { this._peso = pesoSelect.value || null; this._calcResult(); }); }
      this.querySelectorAll('.ai-boomba-breast-btn-' + GEN).forEach(btn => {
        btn.addEventListener('click', () => {
          this.querySelectorAll('.ai-boomba-breast-btn-' + GEN).forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected'); this._breast = btn.dataset.breast; this._calcResult();
        });
      });
    }

    _calcResult() {
      const resultBox = this.querySelector('#ai-boomba-result-' + GEN);
      const resultSize = this.querySelector('#ai-boomba-result-size-' + GEN);
      const resultDesc = this.querySelector('#ai-boomba-result-desc-' + GEN);
      if (!this._peso || !this._breast) { if (resultBox) resultBox.classList.remove('visible'); return; }
      const entry = this.sizeTable[this._peso] && this.sizeTable[this._peso][this._breast];
      if (!entry) return;
      if (resultSize) resultSize.textContent = entry.size;
      if (resultDesc) resultDesc.textContent = entry.desc;
      if (resultBox) resultBox.classList.add('visible');
      this._incrementSizeCounter(resultBox);
    }

    _incrementSizeCounter(resultBox) {
      if (!resultBox) return;
      const enabled = resultBox.dataset.counterEnabled === 'true';
      if (!enabled) return;
      const counterEl = this.querySelector('#ai-boomba-result-counter-' + GEN);
      if (!counterEl) return;
      const startCount = parseInt(resultBox.dataset.counterStart) || 10000;
      const storageKey = 'boomba_size_counter_' + GEN;
      const resetKey = 'boomba_size_counter_reset_' + GEN;
      const now = Date.now(); const H24 = 24 * 60 * 60 * 1000;
      let resetAt = parseInt(localStorage.getItem(resetKey)) || 0;
      if (!resetAt || now >= resetAt) { resetAt = now + H24; localStorage.setItem(resetKey, String(resetAt)); localStorage.setItem(storageKey, '0'); this._sizeCounterDone = false; }
      let count = parseInt(localStorage.getItem(storageKey)) || 0;
      if (!this._sizeCounterDone) { count += 1; localStorage.setItem(storageKey, String(count)); this._sizeCounterDone = true; }
      counterEl.textContent = (startCount + count).toLocaleString() + ' personas ya encontraron su talla';
    }

    _setupBundles() {
      const bundleWrap = this.querySelector('#ai-boomba-bundle-' + GEN);
      if (!bundleWrap) return;
      this._bundle2VariantId = bundleWrap.dataset.bundle2Id || null;
      const cards = this.querySelectorAll('.ai-boomba-bcard-' + GEN);
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const chosen = parseInt(card.dataset.bundle);
          if (this._selectedBundle === chosen) return;
          this._selectedBundle = chosen;
          cards.forEach(c => c.classList.remove('selected')); card.classList.add('selected');
          this._onBundleChange();
        });
      });
    }

    _onBundleChange() {
      const atcBtn = this.querySelector('[name="add"]');
      const atcSpan = atcBtn && atcBtn.querySelector('span');
      if (this._selectedBundle === 2 && this._bundle2VariantId) {
        atcBtn.dataset.bundleMode = '2'; atcBtn.dataset.bundle2Id = this._bundle2VariantId;
        if (atcSpan) atcSpan.textContent = {{ block.settings.bundle2_atc_text | default: 'AÑADIR PACK A LA CESTA' | json }};
      } else {
        atcBtn.dataset.bundleMode = '1';
        if (atcSpan) atcSpan.textContent = {{ block.settings.add_to_cart_text | json }};
      }
    }
  }

  if (!customElements.get('boomba-product-' + GEN)) {
    customElements.define('boomba-product-' + GEN, BoombaProduct);
  }

  /* ── BUNDLE CART INTERCEPTOR ── */
  document.addEventListener('click', async function(e) {
    const atcBtn = e.target.closest('[name="add"]');
    if (!atcBtn) return;
    if (atcBtn.dataset.bundleMode !== '2') return;
    e.preventDefault(); e.stopImmediatePropagation();
    const form = atcBtn.closest('form');
    const mainVariantId = form ? form.querySelector('[name="id"]')?.value : null;
    const bundle2VariantId = atcBtn.dataset.bundle2Id;
    if (!mainVariantId || !bundle2VariantId || bundle2VariantId === 'undefined') { if (form) form.submit(); return; }
    atcBtn.disabled = true;
    const span = atcBtn.querySelector('span'); const originalText = span ? span.textContent : '';
    if (span) span.textContent = '…';
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(mainVariantId), quantity: 1 }, { id: parseInt(bundle2VariantId), quantity: 1 }] })
      });
      if (response.ok) {
        fetch('/cart.js').then(r => r.json()).then(cart => {
          document.querySelectorAll('[data-cart-count], .cart-count, #CartCount, .cart__count, .header__cart-count').forEach(el => { el.textContent = cart.item_count; });
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart, bubbles: true }));
        });
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open', { bubbles: true }));
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.renderContents === 'function') { cartDrawer.renderContents({ items: [] }); document.dispatchEvent(new CustomEvent('cart-drawer:open', { bubbles: true })); }
        if (!document.querySelector('cart-drawer, #CartDrawer, [data-drawer="cart"]')) { window.location.href = '/cart'; }
      } else { const err = await response.json(); console.error('BOOMBA bundle error:', err); if (form) form.submit(); }
    } catch(err) { console.error('BOOMBA bundle add error:', err); if (form) form.submit(); }
    finally { atcBtn.disabled = false; if (span) span.textContent = originalText; }
  }, true);

})();
</script>

